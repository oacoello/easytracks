<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EasyTracks_UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EasyTracks_UI"
    xmlns:converters="using:EasyTracks_UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            
            <converters:MuteColorConverter x:Key="MuteColorConverter" />
            <converters:SoloColorConverter x:Key="SoloColorConverter" />
            <converters:PlayPauseIconConverter x:Key="PlayPauseIconConverter" />
            <converters:PlayPauseColorConverter x:Key="PlayPauseColorConverter" />
            <converters:PadActiveColorConverter x:Key="PadActiveColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
