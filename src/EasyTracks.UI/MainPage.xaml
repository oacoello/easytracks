<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EasyTracks_UI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:EasyTracks_UI.Controls"
    xmlns:vm="using:EasyTracks_UI.ViewModels"
    mc:Ignorable="d"
    Background="#09090B">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ROW 0: Transport & Master Bar -->
        <controls:TransportBarControl
            Grid.Row="0"
            ViewModel="{x:Bind ViewModel.Transport, Mode=OneWay}" />

        <!-- ROW 1: Arrangement / Song Sections Ribbon -->
        <Border
            Grid.Row="1"
            Background="#121214"
            BorderBrush="#27272A"
            BorderThickness="0,0,0,1"
            Padding="16,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Arrangement Section Blocks -->
                    <Border Background="#3B82F6" CornerRadius="4" Padding="12,6">
                        <TextBlock Text="INTRO" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                    </Border>
                    <Border Background="#10B981" CornerRadius="4" Padding="12,6">
                        <TextBlock Text="VERSE 1" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                    </Border>
                    <Border Background="#F59E0B" CornerRadius="4" Padding="12,6">
                        <TextBlock Text="CHORUS" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                    </Border>
                    <Border Background="#10B981" CornerRadius="4" Padding="12,6">
                        <TextBlock Text="VERSE 2" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                    </Border>
                    <Border Background="#F59E0B" CornerRadius="4" Padding="12,6">
                        <TextBlock Text="CHORUS" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                    </Border>
                    <Border Background="#8B5CF6" CornerRadius="4" Padding="12,6">
                        <TextBlock Text="BRIDGE" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                    </Border>
                    <Border Background="#F59E0B" CornerRadius="4" Padding="12,6">
                        <TextBlock Text="CHORUS" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                    </Border>
                    <Border Background="#64748B" CornerRadius="4" Padding="12,6">
                        <TextBlock Text="OUTRO" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ROW 2: Stem Channel Rack + Master Strip -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="12,8,12,12">

            <!-- Horizontal Scrollable Stems Rack -->
            <ScrollViewer
                Grid.Column="0"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled"
                Padding="0,0,12,0">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Channels, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StemChannelViewModel">
                            <controls:StemChannelStripControl ViewModel="{x:Bind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Master Fader Strip (Pinned on the Right) -->
            <Border
                Grid.Column="1"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="1"
                CornerRadius="8"
                Width="92"
                Padding="8">
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                    <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock
                            Text="MASTER"
                            FontWeight="Bold"
                            FontSize="12"
                            Foreground="#F4F4F5"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="MAIN L/R"
                            FontSize="9"
                            Foreground="#A1A1AA"
                            HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Master Fader & Master Meter -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,12" Margin="0,8">
                        <Slider
                            Grid.Column="0"
                            Orientation="Vertical"
                            Minimum="0.0"
                            Maximum="1.0"
                            StepFrequency="0.01"
                            Value="{x:Bind ViewModel.Transport.MasterVolume, Mode=TwoWay}"
                            HorizontalAlignment="Center"
                            Height="210" />

                        <!-- Master Stereo VU Meter -->
                        <Border
                            Grid.Column="1"
                            Background="#27272A"
                            CornerRadius="3"
                            Width="8"
                            Height="210"
                            VerticalAlignment="Center">
                            <Grid VerticalAlignment="Bottom">
                                <Border
                                    Background="#10B981"
                                    CornerRadius="3"
                                    Width="8"
                                    Height="140" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Mute / Solo Global Clear Controls -->
                    <Button
                        Grid.Row="2"
                        Content="Clear Mute"
                        Command="{x:Bind ViewModel.ClearAllMutesCommand, Mode=OneWay}"
                        FontSize="10"
                        HorizontalAlignment="Stretch"
                        Height="24"
                        Padding="0"
                        Background="#27272A"
                        Foreground="#EF4444"
                        Margin="0,0,0,4" />

                    <Button
                        Grid.Row="3"
                        Content="Clear Solo"
                        Command="{x:Bind ViewModel.ClearAllSolosCommand, Mode=OneWay}"
                        FontSize="10"
                        HorizontalAlignment="Stretch"
                        Height="24"
                        Padding="0"
                        Background="#27272A"
                        Foreground="#EAB308" />
                </Grid>
            </Border>

        </Grid>

    </Grid>
</Page>
