<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="EasyTracks_UI.Controls.TransportBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EasyTracks_UI.ViewModels"
    mc:Ignorable="d">

    <Border
        Background="#121214"
        BorderBrush="#27272A"
        BorderThickness="0,0,0,1"
        Padding="16,12">

        <Grid ColumnDefinitions="Auto,*,Auto">

            <!-- LEFT: Playback Transport Buttons -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                
                <!-- Stop Button -->
                <Button
                    Command="{x:Bind ViewModel.StopCommand, Mode=OneWay}"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    Background="#27272A"
                    BorderThickness="0">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" Foreground="#A1A1AA" />
                </Button>

                <!-- Big Play / Pause Button -->
                <Button
                    Command="{x:Bind ViewModel.TogglePlayPauseCommand, Mode=OneWay}"
                    Width="52"
                    Height="52"
                    CornerRadius="26"
                    Background="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource PlayPauseColorConverter}}"
                    BorderThickness="0">
                    <FontIcon
                        Glyph="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource PlayPauseIconConverter}}"
                        FontSize="20"
                        Foreground="#FFFFFF" />
                </Button>
            </StackPanel>

            <!-- CENTER: Song Info, Time & Timeline Scrubber -->
            <Grid Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Song Info & Time -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind ViewModel.SongTitle, Mode=OneWay}"
                            FontWeight="Bold"
                            FontSize="15"
                            Foreground="#F4F4F5" />
                        <TextBlock
                            Text="•"
                            Foreground="#71717A" />
                        <TextBlock
                            Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                            FontSize="13"
                            Foreground="#A1A1AA"
                            VerticalAlignment="Center" />
                        <Border
                            Background="#27272A"
                            CornerRadius="4"
                            Padding="6,2"
                            Margin="8,0,0,0">
                            <TextBlock
                                Text="{x:Bind ViewModel.CurrentSectionName, Mode=OneWay}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#38BDF8" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind ViewModel.CurrentTimeText, Mode=OneWay}"
                            FontFamily="Consolas"
                            FontWeight="Bold"
                            FontSize="14"
                            Foreground="#10B981" />
                        <TextBlock
                            Text="/"
                            Foreground="#71717A" />
                        <TextBlock
                            Text="{x:Bind ViewModel.TotalDurationText, Mode=OneWay}"
                            FontFamily="Consolas"
                            FontSize="13"
                            Foreground="#A1A1AA" />
                    </StackPanel>
                </Grid>

                <!-- Scrubber Slider -->
                <Slider
                    Grid.Row="1"
                    Minimum="0"
                    Maximum="{x:Bind ViewModel.TotalDurationSeconds, Mode=OneWay}"
                    Value="{x:Bind ViewModel.CurrentPositionSeconds, Mode=TwoWay}"
                    Margin="0,4,0,0" />
            </Grid>

            <!-- RIGHT: Tempo (BPM), Key Transpose, Dynamic Pad & Master Vol -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">

                <!-- BPM Box with +/- -->
                <Border
                    Background="#18181B"
                    BorderBrush="#27272A"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6,4">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button
                            Command="{x:Bind ViewModel.DecreaseBpmCommand, Mode=OneWay}"
                            Width="26"
                            Height="26"
                            Padding="0"
                            CornerRadius="13"
                            Background="Transparent"
                            BorderThickness="0">
                            <FontIcon Glyph="&#xE738;" FontSize="10" Foreground="#A1A1AA" />
                        </Button>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="48">
                            <TextBlock
                                Text="{x:Bind ViewModel.Bpm, Mode=OneWay}"
                                FontWeight="Bold"
                                FontSize="13"
                                HorizontalAlignment="Center"
                                Foreground="#F4F4F5" />
                            <TextBlock
                                Text="BPM"
                                FontSize="9"
                                Foreground="#71717A"
                                HorizontalAlignment="Center" />
                        </StackPanel>
                        <Button
                            Command="{x:Bind ViewModel.IncreaseBpmCommand, Mode=OneWay}"
                            Width="26"
                            Height="26"
                            Padding="0"
                            CornerRadius="13"
                            Background="Transparent"
                            BorderThickness="0">
                            <FontIcon Glyph="&#xE710;" FontSize="10" Foreground="#A1A1AA" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Musical Key Transpose with +/- -->
                <Border
                    Background="#18181B"
                    BorderBrush="#27272A"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6,4">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button
                            Command="{x:Bind ViewModel.PitchDownCommand, Mode=OneWay}"
                            Width="26"
                            Height="26"
                            Padding="0"
                            CornerRadius="13"
                            Background="Transparent"
                            BorderThickness="0">
                            <FontIcon Glyph="&#xE738;" FontSize="10" Foreground="#A1A1AA" />
                        </Button>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="48">
                            <TextBlock
                                Text="{x:Bind ViewModel.KeyDisplay, Mode=OneWay}"
                                FontWeight="Bold"
                                FontSize="13"
                                HorizontalAlignment="Center"
                                Foreground="#F4F4F5" />
                            <TextBlock
                                Text="KEY"
                                FontSize="9"
                                Foreground="#71717A"
                                HorizontalAlignment="Center" />
                        </StackPanel>
                        <Button
                            Command="{x:Bind ViewModel.PitchUpCommand, Mode=OneWay}"
                            Width="26"
                            Height="26"
                            Padding="0"
                            CornerRadius="13"
                            Background="Transparent"
                            BorderThickness="0">
                            <FontIcon Glyph="&#xE710;" FontSize="10" Foreground="#A1A1AA" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Dynamic Ambient Pad Toggle Button -->
                <ToggleButton
                    IsChecked="{x:Bind ViewModel.IsPadActive, Mode=TwoWay}"
                    Command="{x:Bind ViewModel.TogglePadCommand, Mode=OneWay}"
                    Height="36"
                    CornerRadius="6"
                    Padding="10,0"
                    Background="{x:Bind ViewModel.IsPadActive, Mode=OneWay, Converter={StaticResource PadActiveColorConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEC15;" FontSize="12" Foreground="#FFFFFF" />
                        <TextBlock Text="PAD" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" />
                    </StackPanel>
                </ToggleButton>

                <!-- Master Volume Slider -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="#A1A1AA" />
                    <Slider
                        Minimum="0.0"
                        Maximum="1.0"
                        StepFrequency="0.01"
                        Value="{x:Bind ViewModel.MasterVolume, Mode=TwoWay}"
                        Width="80"
                        VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
