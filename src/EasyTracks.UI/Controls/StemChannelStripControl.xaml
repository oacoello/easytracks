<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="EasyTracks_UI.Controls.StemChannelStripControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EasyTracks_UI.ViewModels"
    mc:Ignorable="d"
    Width="88"
    Margin="4,4,4,8">

    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="6,8">

        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

            <!-- Category Indicator Bar & Channel Name -->
            <StackPanel Grid.Row="0" Spacing="4">
                <Border
                    Height="4"
                    CornerRadius="2"
                    Background="{x:Bind ViewModel.CategoryBrush, Mode=OneWay}" />

                <TextBlock
                    Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                    FontWeight="SemiBold"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                
                <TextBlock
                    Text="{x:Bind ViewModel.PanText, Mode=OneWay}"
                    FontSize="10"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Pan Slider (Horizontal, compact) -->
            <Slider
                Grid.Row="1"
                Minimum="-1.0"
                Maximum="1.0"
                StepFrequency="0.05"
                Value="{x:Bind ViewModel.Pan, Mode=TwoWay}"
                DoubleTapped="OnPanSliderDoubleTapped"
                SmallChange="0.05"
                Margin="0,2,0,4"
                ToolTipService.ToolTip="Doble clic para centrar (C)" />

            <!-- Mute & Solo Buttons -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,2,0,8" ColumnSpacing="4">
                <ToggleButton
                    Grid.Column="0"
                    Content="M"
                    FontWeight="Bold"
                    FontSize="11"
                    IsChecked="{x:Bind ViewModel.IsMuted, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    Height="28"
                    Padding="0"
                    Background="{x:Bind GetMuteBrush(ViewModel.IsMuted), Mode=OneWay}"
                    Foreground="{x:Bind GetMuteSoloForeground(ViewModel.IsMuted), Mode=OneWay}" />

                <ToggleButton
                    Grid.Column="1"
                    Content="S"
                    FontWeight="Bold"
                    FontSize="11"
                    IsChecked="{x:Bind ViewModel.IsSolo, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    Height="28"
                    Padding="0"
                    Background="{x:Bind GetSoloBrush(ViewModel.IsSolo), Mode=OneWay}"
                    Foreground="{x:Bind GetMuteSoloForeground(ViewModel.IsSolo), Mode=OneWay}" />
            </Grid>

            <!-- Fader & VU Meter Section (Compact) -->
            <Grid Grid.Row="3" ColumnDefinitions="*,10" Margin="0,2">
                <!-- Vertical Fader -->
                <Slider
                    Grid.Column="0"
                    Orientation="Vertical"
                    Minimum="0.0"
                    Maximum="1.25"
                    StepFrequency="0.01"
                    Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                    DoubleTapped="OnVolumeSliderDoubleTapped"
                    ToolTipService.ToolTip="Doble clic para regresar a 0.0 dB (Volumen 1)"
                    HorizontalAlignment="Center"
                    Height="120" />

                <!-- VU Meter Level Bar -->
                <Border
                    Grid.Column="1"
                    Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                    CornerRadius="3"
                    Width="6"
                    Height="120"
                    VerticalAlignment="Center">
                    <Grid VerticalAlignment="Bottom">
                        <Border
                            Background="#10B981"
                            CornerRadius="3"
                            Width="6"
                            Height="{x:Bind ViewModel.MeterHeight, Mode=OneWay}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- dB Readout -->
            <TextBlock
                Grid.Row="4"
                Text="{x:Bind ViewModel.VolumeDbText, Mode=OneWay}"
                FontSize="11"
                FontFamily="Consolas"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                HorizontalAlignment="Center"
                Margin="0,4,0,4" />

            <!-- Output Bus Selector Button -->
            <Button
                Grid.Row="5"
                Content="{x:Bind ViewModel.OutputBusText, Mode=OneWay}"
                Click="OnOutputBusSelectorClick"
                FontSize="10"
                FontWeight="SemiBold"
                HorizontalAlignment="Stretch"
                Height="24"
                Padding="2,0"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                Foreground="#0284C7"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                ToolTipService.ToolTip="Seleccionar salida (Mackie DL16S USB 1-16 o Split L/R)" />
        </Grid>
    </Border>
</UserControl>
