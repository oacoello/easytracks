<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="EasyTracks_UI.Controls.WaveformSectionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EasyTracks_UI.ViewModels"
    mc:Ignorable="d">

    <!-- Seamless section inside continuous waveform ribbon (wide & prominent) -->
    <Border
        Width="{x:Bind ViewModel.SectionWidth, Mode=OneWay}"
        Height="100"
        Background="{x:Bind GetSectionBackgroundBrush(ViewModel.IsActive), Mode=OneWay}"
        BorderBrush="{x:Bind GetSectionBorderBrush(ViewModel.IsActive, ViewModel.IsLooping), Mode=OneWay}"
        BorderThickness="{x:Bind GetSectionBorderThickness(ViewModel.IsActive, ViewModel.IsLooping), Mode=OneWay}"
        RightTapped="OnSectionRightTapped"
        Padding="6,6">

        <Grid RowDefinitions="Auto,*">

            <!-- Section Header Tag Badge, Bar Count & Loop Toggle Button -->
            <Grid Grid.Row="0" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Section Badge (Clickable for quick rename/resize menu) -->
                <Button
                    Grid.Column="0"
                    Click="OnSectionBadgeClicked"
                    Background="{x:Bind GetSectionBrush(ViewModel.ColorHex), Mode=OneWay}"
                    BorderThickness="0"
                    CornerRadius="4"
                    Padding="8,2"
                    MinHeight="22"
                    ToolTipService.ToolTip="Clic para renombrar, ajustar compases (Snap-to-Grid) o dividir sección">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock
                            Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                            FontWeight="Bold"
                            FontSize="11"
                            Foreground="#FFFFFF" />
                        <TextBlock
                            Text="{x:Bind ViewModel.BarCountText, Mode=OneWay}"
                            FontSize="9"
                            VerticalAlignment="Center"
                            Foreground="#E2E8F0" />
                    </StackPanel>
                </Button>

                <!-- Active Loop Pass Badge -->
                <Border
                    Grid.Column="1"
                    Visibility="{x:Bind ViewModel.LoopBadgeVisibility, Mode=OneWay}"
                    Background="#065F46"
                    BorderBrush="#10B981"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="5,1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind ViewModel.LoopBadgeText, Mode=OneWay}"
                        FontSize="9"
                        FontWeight="Bold"
                        Foreground="#34D399" />
                </Border>

                <!-- Section Loop Button (Playback Style) -->
                <Button
                    Grid.Column="2"
                    Click="OnLoopClicked"
                    Width="28"
                    Height="24"
                    Padding="0"
                    CornerRadius="4"
                    Background="{x:Bind GetLoopBrush(ViewModel.IsLooping), Mode=OneWay}"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Bucle en vivo de esta sección (Loop)">
                    <FontIcon Glyph="&#xE8EE;" FontSize="11" Foreground="{x:Bind GetLoopForeground(ViewModel.IsLooping), Mode=OneWay}" />
                </Button>
            </Grid>

            <!-- Procedural Soundwave Waveform Bars with BPM Beat Division (continuous ribbon) -->
            <ItemsControl
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.WaveformBars, Mode=OneWay}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,4,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BarItem">
                        <Border
                            Width="3"
                            Height="{x:Bind Height, Mode=OneWay}"
                            CornerRadius="1.5"
                            Background="{x:Bind BarBrush, Mode=OneWay}"
                            VerticalAlignment="Center" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </Border>
</UserControl>
