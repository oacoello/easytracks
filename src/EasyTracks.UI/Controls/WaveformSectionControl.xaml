<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="EasyTracks_UI.Controls.WaveformSectionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EasyTracks_UI.ViewModels"
    mc:Ignorable="d"
    Margin="2,0">

    <Border
        Width="120"
        Height="72"
        Background="#18181B"
        BorderBrush="#27272A"
        BorderThickness="1"
        CornerRadius="6"
        Padding="6,6">

        <Grid RowDefinitions="Auto,*">

            <!-- Section Header Tag -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                <Border
                    Background="{x:Bind GetSectionBrush(ViewModel.ColorHex), Mode=OneWay}"
                    CornerRadius="3"
                    Padding="6,2">
                    <TextBlock
                        Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                        FontWeight="Bold"
                        FontSize="10"
                        Foreground="#FFFFFF" />
                </Border>
            </StackPanel>

            <!-- Procedural Soundwave Waveform Bars -->
            <ItemsControl
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.WaveformBars, Mode=OneWay}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,4,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:Double">
                        <Border
                            Width="3"
                            Height="{x:Bind GetBarHeight((x:Double)), Mode=OneWay}"
                            CornerRadius="1.5"
                            Background="#52525B"
                            VerticalAlignment="Center" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </Border>
</UserControl>
