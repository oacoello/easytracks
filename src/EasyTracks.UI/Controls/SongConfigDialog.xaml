<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="EasyTracks_UI.Controls.SongConfigDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Configuración de Canción &amp; Metadata"
    PrimaryButtonText="Guardar y Aplicar"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="12"
    MinWidth="640"
    MaxWidth="760">

    <Grid MinWidth="600" RowDefinitions="Auto,Auto,*" Margin="0,8,0,0">

        <!-- 1. MULTITRACKS.COM / SECUENCIAS.COM AUTO-FETCH SECTION -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14"
            Margin="0,0,0,16">
            <StackPanel Spacing="10">
                <TextBlock
                    Text="Importar datos desde MultiTracks.com o Secuencias.com"
                    FontWeight="SemiBold"
                    FontSize="13"
                    Foreground="{StaticResource AppAccentBrush}" />

                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox
                        x:Name="UrlTextBox"
                        Grid.Column="0"
                        PlaceholderText="https://www.multitracks.com/songs/..."
                        Height="36" />

                    <Button
                        x:Name="FetchBtn"
                        Grid.Column="1"
                        Click="OnFetchClicked"
                        Content="Obtener Datos"
                        Style="{StaticResource AccentButtonStyle}"
                        FontWeight="SemiBold"
                        Height="36"
                        MinWidth="120"
                        Padding="14,0"
                        Margin="8,0,0,0" />

                    <ProgressRing
                        x:Name="FetchProgress"
                        Grid.Column="2"
                        IsActive="False"
                        Visibility="Collapsed"
                        Width="24"
                        Height="24"
                        Margin="8,0,0,0" />
                </Grid>

                <TextBlock
                    x:Name="FetchStatusText"
                    Text=""
                    FontSize="11"
                    Foreground="#10B981"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- 2. EDITABLE SONG METADATA FIELDS -->
        <StackPanel Grid.Row="1" Spacing="12">
            <Grid ColumnDefinitions="1.2*,1*,1*">
                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                    <TextBlock Text="Título de la Canción" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="TitleBox" Height="34" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,6,0">
                    <TextBlock Text="Artista / Grupo" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="ArtistBox" Height="34" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4" Margin="6,0,0,0">
                    <TextBlock Text="Arrangement / Álbum" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="AlbumBox" PlaceholderText="Ej: Live / Versión Álbum" Height="34" />
                </StackPanel>
            </Grid>

            <!-- BPM, Key, Scale & Time Signature -->
            <Grid ColumnDefinitions="*,1.2*,1.2*,1.2*">
                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                    <TextBlock Text="BPM" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="BpmBox" Text="120" Height="34" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,6,0">
                    <TextBlock Text="Tono Original (Key)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="KeyCombo" HorizontalAlignment="Stretch" Height="34" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4" Margin="6,0,6,0">
                    <TextBlock Text="Escala" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="ScaleCombo" HorizontalAlignment="Stretch" Height="34">
                        <ComboBoxItem Content="Mayor" IsSelected="True" />
                        <ComboBoxItem Content="Menor" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3" Spacing="4" Margin="6,0,0,0">
                    <TextBlock Text="Compás (Métrica)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="TimeSigCombo" HorizontalAlignment="Stretch" Height="34">
                        <ComboBoxItem Content="4/4" IsSelected="True" />
                        <ComboBoxItem Content="6/8" />
                        <ComboBoxItem Content="3/4" />
                        <ComboBoxItem Content="2/4" />
                        <ComboBoxItem Content="12/8" />
                        <ComboBoxItem Content="5/4" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Arrangement Sections Definition -->
            <StackPanel Spacing="4" Margin="0,4,0,0">
                <TextBlock Text="Estructura de Secciones (separadas por comas)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox
                    x:Name="SectionsBox"
                    Text="Intro, Verso 1, Coro, Verso 2, Coro, Puente, Coro, Outro"
                    Height="34" />
                <TextBlock
                    Text="Ejemplo: Intro, Verso 1, Pre-Coro, Coro, Verso 2, Puente, Coro, Outro"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </StackPanel>

    </Grid>
</ContentDialog>
