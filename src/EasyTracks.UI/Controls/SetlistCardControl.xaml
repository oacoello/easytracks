<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="EasyTracks_UI.Controls.SetlistCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EasyTracks_UI.ViewModels"
    mc:Ignorable="d">

    <Border
        Tapped="OnCardTapped"
        Padding="0"
        Background="Transparent"
        BorderThickness="0"
        CornerRadius="8"
        Margin="0,0,6,0">

        <Border
            Width="254"
            Height="92"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{x:Bind GetBorderBrush(ViewModel.IsSelected), Mode=OneWay}"
            BorderThickness="{x:Bind GetBorderThickness(ViewModel.IsSelected), Mode=OneWay}"
            CornerRadius="10"
            Padding="10">

            <Grid ColumnDefinitions="Auto,72,*,Auto">

                <!-- Drag Handle Indicator (Visible in EDIT Mode) -->
                <FontIcon
                    Grid.Column="0"
                    Visibility="{x:Bind ViewModel.EditVisibility, Mode=OneWay}"
                    Glyph="&#xE784;"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    ToolTipService.ToolTip="Arrastra para reordenar en el Setlist" />

                <!-- Album Art / Thumbnail (Large) -->
                <Border
                    Grid.Column="1"
                    Width="72"
                    Height="72"
                    CornerRadius="8"
                    Background="{x:Bind ViewModel.CoverBrush, Mode=OneWay}">
                    <Grid>
                        <FontIcon
                            Visibility="{x:Bind ViewModel.CoverIconVisibility, Mode=OneWay}"
                            Glyph="&#xEC4F;"
                            FontSize="26"
                            Foreground="#FFFFFF" />
                        <Image
                            Visibility="{x:Bind ViewModel.CoverImageVisibility, Mode=OneWay}"
                            Source="{x:Bind ViewModel.CoverImageSource, Mode=OneWay}"
                            Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <!-- Song Details: Title & Stems Missing Alert -->
                <StackPanel Grid.Column="2" Margin="12,0,6,0" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        FontWeight="Bold"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="2"
                        TextWrapping="Wrap" />

                    <!-- Stems missing warning (Only shown if audio files are not in folder) -->
                    <Border
                        Visibility="{x:Bind ViewModel.StemsMissingVisibility, Mode=OneWay}"
                        Background="#3B1219"
                        BorderBrush="#EF4444"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2"
                        HorizontalAlignment="Left"
                        ToolTipService.ToolTip="{x:Bind ViewModel.StemsMissingTooltip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE783;" FontSize="10" Foreground="#F87171" />
                            <TextBlock
                                Text="Stems no encontrados"
                                FontSize="9"
                                FontWeight="Bold"
                                Foreground="#F87171" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Delete Button inside Card (Visible in EDIT mode) -->
                <Button
                    Grid.Column="3"
                    Click="OnDeleteClicked"
                    Visibility="{x:Bind ViewModel.EditVisibility, Mode=OneWay}"
                    Content="&#xE74D;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="12"
                    Width="30"
                    Height="30"
                    Padding="0"
                    CornerRadius="6"
                    Background="#3F1D1D"
                    Foreground="#EF4444"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Eliminar del Setlist" />

            </Grid>
        </Border>
    </Border>
</UserControl>
