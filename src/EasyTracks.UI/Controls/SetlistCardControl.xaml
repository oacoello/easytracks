<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="EasyTracks_UI.Controls.SetlistCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EasyTracks_UI.ViewModels"
    mc:Ignorable="d">

    <Button
        Click="OnCardClicked"
        Padding="0"
        Background="Transparent"
        BorderThickness="0"
        CornerRadius="8"
        Margin="0,0,10,0">

        <Border
            Width="175"
            Height="64"
            Background="#18181B"
            BorderBrush="{x:Bind GetBorderBrush(ViewModel.IsSelected), Mode=OneWay}"
            BorderThickness="{x:Bind GetBorderThickness(ViewModel.IsSelected), Mode=OneWay}"
            CornerRadius="8"
            Padding="8">

            <Grid ColumnDefinitions="48,*">

                <!-- Album Art / Thumbnail Placeholder -->
                <Border
                    Grid.Column="0"
                    Width="48"
                    Height="48"
                    CornerRadius="6"
                    Background="{x:Bind GetCoverBrush(ViewModel.CoverGradientStart), Mode=OneWay}">
                    <FontIcon Glyph="&#xEC4F;" FontSize="18" Foreground="#FFFFFF" />
                </Border>

                <!-- Song Details -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        FontWeight="Bold"
                        FontSize="13"
                        Foreground="#F4F4F5"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                        FontSize="11"
                        Foreground="#A1A1AA"
                        TextTrimming="CharacterEllipsis"
                        Margin="0,1,0,3" />

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="#27272A" CornerRadius="3" Padding="4,1">
                            <TextBlock
                                Text="{x:Bind ViewModel.KeyDisplay, Mode=OneWay}"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Foreground="#38BDF8" />
                        </Border>
                        <Border Background="#27272A" CornerRadius="3" Padding="4,1">
                            <TextBlock
                                Text="{x:Bind GetBpmText(ViewModel.Bpm), Mode=OneWay}"
                                FontSize="9"
                                Foreground="#A1A1AA" />
                        </Border>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>
    </Button>
</UserControl>
